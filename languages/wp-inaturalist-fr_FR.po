#: includes/ToolsPage.php:183
msgid "Asks iNaturalist for the number of observations, then loads them in the background."
msgstr "Demande à iNaturalist le nombre d'observations, puis les charge en arrière-plan."

#: includes/ToolsPage.php:194
msgid "Photos of the media library"
msgstr "Photos de la médiathèque"

#: includes/ToolsPage.php:196
msgid "This option is off in the settings: the photos of iNaturalist are used."
msgstr "Cette option est désactivée dans les réglages : les photos d'iNaturalist sont utilisées."

