msgid "iNaturalist observations"
msgstr "Observations iNaturalist"

#: blocks/wp-inaturalist/block.json
msgctxt "block description"
msgid "Lists the species observed on iNaturalist around the date of the post."
msgstr "Liste les espèces observées sur iNaturalist autour de la date de l'article."
