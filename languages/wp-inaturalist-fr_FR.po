#. Plugin Name of the plugin
#: wp-inaturalist.php
msgid "WP iNaturalist"
msgstr "WP iNaturalist"

#. Description of the plugin
#: wp-inaturalist.php
msgid "Lists the species observed on iNaturalist for the period around a post's date."
msgstr "Liste les espèces observées sur iNaturalist pendant la période autour de la date d'un article."

#. Author of the plugin
#: wp-inaturalist.php
msgid "Eric van der Vlist"
msgstr "Eric van der Vlist"

#: includes/Assets.php:53
msgid "Checking…"
msgstr "Vérification…"

#. translators: %s: iNaturalist login.
#: includes/Assets.php:55
#, php-format
msgid "Account found: %s"
msgstr "Compte trouvé : %s"

#: includes/Assets.php:56
msgid "No iNaturalist account has this login."
msgstr "Aucun compte iNaturalist n'a cet identifiant."

#: includes/Assets.php:57
msgid "This is not a valid login: use letters, digits, \"-\" and \"_\"."
msgstr "Cet identifiant n'est pas valide : utilisez des lettres, des chiffres, « - » et « _ »."

#: includes/Assets.php:58
msgid "iNaturalist did not answer: try again later."
msgstr "iNaturalist n'a pas répondu : réessayez plus tard."

#: includes/Assets.php:59
msgid "The check could not be done."
msgstr "La vérification n'a pas pu être faite."

#: includes/Assets.php:70
#: includes/SettingsPage.php:36
#: includes/SettingsPage.php:37
#: includes/SettingsPage.php:88
#: includes/ToolsPage.php:37
#: includes/ToolsPage.php:71
msgid "iNaturalist"
msgstr "iNaturalist"

#: includes/Assets.php:71
msgid "Refresh observations"
msgstr "Rafraîchir les observations"

#: includes/Assets.php:72
msgid "Saving the post first…"
msgstr "Enregistrement de l'article d'abord…"

#: includes/Assets.php:73
msgid "The refresh of the observations of this post has started."
msgstr "Le rafraîchissement des observations de cet article a démarré."

#: includes/Assets.php:74
#: includes/ToolsPage.php:48
msgid "A refresh is running: this one will start when it ends."
msgstr "Un rafraîchissement est en cours : celui-ci démarrera quand il sera terminé."

#: includes/Assets.php:75
msgid "This post has no iNaturalist block yet: add one and save the post."
msgstr "Cet article n'a pas encore de bloc iNaturalist : ajoutez-en un et enregistrez l'article."

#: includes/Assets.php:76
#: includes/Block.php:69
#: includes/ToolsPage.php:50
msgid "Set the iNaturalist login in the settings first."
msgstr "Renseignez d'abord l'identifiant iNaturalist dans les réglages."

#: includes/Assets.php:77
msgid "The date of this post cannot be used."
msgstr "La date de cet article est inutilisable."

#: includes/Assets.php:78
msgid "The refresh could not be requested."
msgstr "Le rafraîchissement n'a pas pu être demandé."

#: includes/Block.php:46
msgid "Period"
msgstr "Période"

#: includes/Block.php:47
msgid "Number of units"
msgstr "Nombre d'unités"

#: includes/Block.php:48
msgid "Unit"
msgstr "Unité"

#: includes/Block.php:49
msgid "Days"
msgstr "Jours"

#: includes/Block.php:50
msgid "Weeks"
msgstr "Semaines"

#: includes/Block.php:51
msgid "Months"
msgstr "Mois"

#: includes/Block.php:52
msgid "The period ends on the date of the post."
msgstr "La période se termine à la date de l'article."

#: includes/Block.php:53
msgid "Nothing to show yet."
msgstr "Rien à afficher pour l'instant."

#: includes/Block.php:88
msgid "No observation in the cache for this period. Save the post, then use \"Refresh observations\" in the sidebar."
msgstr "Aucune observation dans le cache pour cette période. Enregistrez l'article, puis utilisez « Rafraîchir les observations » dans la barre latérale."

#: includes/Renderer.php:80
msgid "We observed the following species on iNaturalist:"
msgstr "Nous avons observé les espèces suivantes sur iNaturalist :"

#: includes/SettingsPage.php:74
msgid "Observations"
msgstr "Observations"

#: includes/SettingsPage.php:75
msgid "iNaturalist login"
msgstr "Identifiant iNaturalist"

#: includes/SettingsPage.php:76
msgid "Language of the names"
msgstr "Langue des noms"

#: includes/SettingsPage.php:77
msgid "Observations shown"
msgstr "Observations affichées"

#: includes/SettingsPage.php:78
msgid "Hour of the daily refresh"
msgstr "Heure du rafraîchissement quotidien"

#: includes/SettingsPage.php:86
msgid "You do not have permission to change these settings."
msgstr "Vous n'avez pas la permission de modifier ces réglages."

#: includes/SettingsPage.php:108
msgid "Check"
msgstr "Vérifier"

#: includes/SettingsPage.php:110
msgid "Only public observations of this user are read. No password or token is needed or stored."
msgstr "Seules les observations publiques de cet utilisateur sont lues. Aucun mot de passe ni jeton n'est nécessaire ni conservé."

#: includes/SettingsPage.php:123
msgid "Language code of the common names, for example \"fr\". Leave empty to use the language of the site."
msgstr "Code de langue des noms courants, par exemple « fr ». Laissez vide pour utiliser la langue du site."

#: includes/SettingsPage.php:132
msgid "Research grade only"
msgstr "Niveau « recherche » uniquement"

#: includes/SettingsPage.php:133
msgid "All observations"
msgstr "Toutes les observations"

#: includes/SettingsPage.php:151
msgid "From 0 to 23, in the time of the site."
msgstr "De 0 à 23, à l'heure du site."

#: includes/SettingsPage.php:164
msgid "The iNaturalist login may only contain letters, digits, \"-\" and \"_\"."
msgstr "L'identifiant iNaturalist ne peut contenir que des lettres, des chiffres, « - » et « _ »."

#: includes/SettingsPage.php:178
msgid "The language must be a code of two or three letters, such as \"fr\", or empty."
msgstr "La langue doit être un code de deux ou trois lettres, comme « fr », ou être vide."

#: includes/SettingsPage.php:192
msgid "Unknown choice of observations."
msgstr "Choix d'observations inconnu."

#: includes/SettingsPage.php:205
msgid "The hour must be a whole number from 0 to 23."
msgstr "L'heure doit être un nombre entier de 0 à 23."

#: includes/ToolsPage.php:47
msgid "The refresh was started."
msgstr "Le rafraîchissement a démarré."

#: includes/ToolsPage.php:49
msgid "A refresh is already running."
msgstr "Un rafraîchissement est déjà en cours."

#: includes/ToolsPage.php:51
msgid "The dates are not valid: use real days, the first not after the last, at most about ten years apart."
msgstr "Les dates ne sont pas valides : indiquez de vraies dates, la première pas après la dernière, à dix ans d'écart au plus."

#: includes/ToolsPage.php:52
msgid "The refresh was stopped."
msgstr "Le rafraîchissement a été arrêté."

#: includes/ToolsPage.php:53
msgid "No refresh is running."
msgstr "Aucun rafraîchissement n'est en cours."

#: includes/ToolsPage.php:54
msgid "The refresh was resumed."
msgstr "Le rafraîchissement a repris."

#: includes/ToolsPage.php:55
msgid "There is no stopped or failed refresh to resume."
msgstr "Il n'y a aucun rafraîchissement arrêté ou en échec à reprendre."

#: includes/ToolsPage.php:56
msgid "The cache was emptied."
msgstr "Le cache a été vidé."

#: includes/ToolsPage.php:65
msgid "You do not have permission to use this page."
msgstr "Vous n'avez pas la permission d'utiliser cette page."

