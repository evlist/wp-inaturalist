<ruleset name="wp-inaturalist">
    <description>Coding standard for wp-inaturalist (WordPress), clean from the first commit.</description>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <file>includes</file>
    <file>blocks</file>
    <file>tests</file>
    <file>uninstall.php</file>
    <file>wp-inaturalist.php</file>

    <rule ref="WordPress"/>
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array"><element value="wp-inaturalist"/></property>
        </properties>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array"><element value="wpinat"/><element value="Evlist\WpInaturalist"/></property>
        </properties>
    </rule>

    <!-- One namespaced class per file named after the class (PSR-4 style), not class-*.php. -->
    <rule ref="WordPress.Files.FileName">
        <exclude-pattern>includes/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <!-- camelCase for methods and properties, as in wp-whobird. -->
    <rule ref="WordPress.NamingConventions.ValidFunctionName">
        <exclude-pattern>includes/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.ValidVariableName">
        <exclude-pattern>includes/*</exclude-pattern>
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <!-- The tests define stand-ins for WordPress functions and use PHP's own functions freely. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.FunctionComment">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.VariableComment">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Commenting.DocComment">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.OneObjectStructurePerFile">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <rule ref="Universal.Files.SeparateFunctionsFromOO">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.GlobalVariablesOverride">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <rule ref="Universal.NamingConventions.NoReservedKeywordParameterNames">
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DiscouragedPHPFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="Squiz.Commenting.FileComment">
        <exclude-pattern>tests/scripts/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.WP.AlternativeFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.PHP.DevelopmentFunctions">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security.EscapeOutput">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
